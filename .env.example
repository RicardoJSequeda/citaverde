# ==================== SUPABASE ====================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==================== REDIS / UPSTASH ====================
# For serverless Redis (recommended for Vercel)
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Or for self-hosted Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== NOTIFICATION PROVIDERS ====================
# Email (choose one)
# SENDGRID_API_KEY=your-sendgrid-key
# RESEND_API_KEY=your-resend-key
# MAILGUN_API_KEY=your-mailgun-key

# SMS (choose one)
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
# AWS_SNS_REGION=us-east-1

# Push Notifications (choose one)
# FIREBASE_PROJECT_ID=your-firebase-project
# FIREBASE_PRIVATE_KEY=your-firebase-private-key
# ONESIGNAL_APP_ID=your-onesignal-id
# ONESIGNAL_API_KEY=your-onesignal-key

# ==================== MONITORING & SENTRY ====================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ==================== BULL QUEUE (Notifications Worker) ====================
BULL_REDIS_URL=redis://localhost:6379

# ==================== ENVIRONMENT ====================
NODE_ENV=development

# ==================== VERCEL (if deployed) ====================
VERCEL_URL=

# ==================== OPTIONAL: FEATURES ====================
# Enable/disable features
ENABLE_REALTIME_QUEUE=true
ENABLE_NOTIFICATIONS=true
ENABLE_MONITORING=true
ENABLE_CACHE=true

# Cache settings
CACHE_TTL_SLOTS=1800
CACHE_TTL_QUEUE=300
CACHE_TTL_METRICS=3600

# Queue settings
QUEUE_WORKER_CONCURRENCY=5
NOTIFICATION_RETRY_ATTEMPTS=3
