// ============================================================================
// EXAMPLE: Notification Processing Webhook with Idempotency
// ============================================================================
// This example shows how to implement idempotent notification processing
// Location: app/api/notifications/process/route.ts
// 
// Features:
// - QStash signature verification
// - Idempotency key support (prevent duplicate sends)
// - Multiple channel support (email, SMS, push)
// - Error logging to Dead Letter Queue
// - Sentry monitoring
// ============================================================================

import { createServerClient } from "@/lib/supabase/server"
import { verifySignatureAppRouter } from "@upstash/qstash/dist/nextjs"
import { captureException, captureMessage } from "@sentry/nextjs"
import { z } from "zod"

// ============================================================================
// TYPE DEFINITIONS
// ============================================================================

interface NotificationPayload {
  id: string
  user_id: string
  type: string
  channel: "email" | "sms" | "push"
  subject: string
  message: string
  appointment_id?: string
  queue_ticket_id?: string
  created_at: string
}

interface WebhookPayload {
  notificationId: string
  userId: string
  type: string
  channel: "email" | "sms" | "push"
  subject: string
  message: string
  appointmentId?: string
  queueTicketId?: string
  idempotencyKey?: string
}

// ============================================================================
// VALIDATION SCHEMA
// ============================================================================

const WebhookPayloadSchema = z.object({
  notificationId: z.string().uuid("Invalid notification ID"),
  userId: z.string().uuid("Invalid user ID"),
  type: z.string(),
  channel: z.enum(["email", "sms", "push"]),
  subject: z.string().min(1, "Subject required"),
  message: z.string().min(1, "Message required"),
  appointmentId: z.string().uuid().optional(),
  queueTicketId: z.string().uuid().optional(),
  idempotencyKey: z.string().optional(),
})

type WebhookInput = z.infer<typeof WebhookPayloadSchema>

